rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasRole(role) {
      return isSignedIn() && getRole() == role;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || request.auth.uid == userId;
    }

    // Stocks
    match /stocks/{stockId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('STOCK_MANAGER');
    }

    // Sales
    match /sales/{saleId} {
      allow read: if hasRole('SUPER_ADMIN') || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if hasRole('SELLER') || hasRole('SUPER_ADMIN');
    }

    // Prospects
    match /prospects/{prospectId} {
      allow read, write: if hasRole('SUPER_ADMIN') || hasRole('SALES_AGENT');
    }

    // Locations
    match /locations/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId;
    }
  }
}
